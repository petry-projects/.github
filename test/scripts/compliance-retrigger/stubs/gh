#!/usr/bin/env bash
# Smart gh stub for compliance-retrigger tests.
# Routes responses based on endpoint patterns in argv.
#
# Env vars:
#   GH_STUB_LOG        — append-only log of all invocations (quoted args, one per line)
#   GH_STUB_ENABLE_LOG — append-only log of workflow-enable PUT calls specifically
#   GH_STUB_REPOS      — newline-separated repo names returned for org repos listing
#                        (default: "test-repo")
#   GH_STUB_WORKFLOW_STATE — state string returned for dev-lead.yml queries
#                            (default: "disabled_manually")
#   GH_STUB_EXIT       — exit code for unmatched calls (default: 0)
#   GH_STUB_SEARCH_FAIL_TIMES — number of initial search/issues calls that should
#                            fail (exit 1, emit an error body) before succeeding.
#                            Simulates transient API errors (rate limit / 5xx) so
#                            tests can exercise the retry path. Uses a counter file
#                            to persist the fail count across stub invocations.
#   GH_STUB_SEARCH_FAIL_FILE — path to the counter file for the above
#                            (default: "<dir of GH_STUB_LOG>/search_fail.count").

set -euo pipefail

if [ -n "${GH_STUB_LOG:-}" ]; then
  printf '%q ' "$@" >>"$GH_STUB_LOG"
  printf '\n' >>"$GH_STUB_LOG"
fi

# Detect workflow enable calls (gh api -X PUT .../enable)
for arg in "$@"; do
  if [[ "$arg" == */enable ]]; then
    if [ -n "${GH_STUB_ENABLE_LOG:-}" ]; then
      printf '%q ' "$@" >>"$GH_STUB_ENABLE_LOG"
      printf '\n' >>"$GH_STUB_ENABLE_LOG"
    fi
    exit 0
  fi
done

# Route responses by endpoint URL
for arg in "$@"; do
  case "$arg" in
    *"orgs/"*"/repos"*)
      printf '%s\n' "${GH_STUB_REPOS:-test-repo}"
      exit 0
      ;;
    *"search/issues"*)
      fail_times="${GH_STUB_SEARCH_FAIL_TIMES:-0}"
      if [ "$fail_times" -gt 0 ]; then
        counter="${GH_STUB_SEARCH_FAIL_FILE:-${GH_STUB_LOG%/*}/search_fail.count}"
        n=0
        [ -f "$counter" ] && n="$(cat "$counter")"
        if [ "$n" -lt "$fail_times" ]; then
          printf '%s\n' "$((n + 1))" >"$counter"
          printf '{"message":"API rate limit exceeded","documentation_url":"https://docs.github.com/rest"}\n'
          exit 1
        fi
      fi
      printf '{"total_count":0,"items":[]}\n'
      exit 0
      ;;
    *"actions/workflows/dev-lead.yml"*)
      printf '%s\n' "${GH_STUB_WORKFLOW_STATE:-disabled_manually}"
      exit 0
      ;;
  esac
done

exit "${GH_STUB_EXIT:-0}"
